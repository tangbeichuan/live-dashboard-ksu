#!/sbin/sh
umask 022
ui_print() { echo "$1"; }
require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || [ -f /data/adb/ksu/bin/ksud ] || require_new_magisk
[ -f /data/adb/magisk/util_functions.sh ] && { . /data/adb/magisk/util_functions.sh; [ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk; install_module; exit 0; }
ui_print "KernelSU detected - install via KernelSU app"
exit 0
